{
  "name": "dsh-peers-sunny",
  "version": "0.8.0",
  "description": "让两台设备上的 DSH 互为对端：互相派活、互相翻对方机器的文件、接着对方的活继续干（基于 ds-harness-remote）；每台设备可起名，面板长在 Remote 的「远程工作台」弹窗里。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "remote",
    "peer",
    "agent",
    "multi-device"
  ],
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "locale/",
    "scripts/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "peerDependencies": {
    "ds-harness-remote": ">=0.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuanzhihang-s/dsh-peers-sunny.git"
  },
  "homepage": "https://github.com/xuanzhihang-s/dsh-peers-sunny#readme",
  "bugs": {
    "url": "https://github.com/xuanzhihang-s/dsh-peers-sunny/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "SYH",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "icon": "./icon.svg"
}