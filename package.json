{
  "name": "dsh-peers-syh",
  "version": "0.7.1",
  "description": "给每台 DSH 设备起名（可拨 / 已连接 / 仅连入三源合并），名字跨设备互报，并让一个 agent 直接给另一台设备上的 agent 派活（基于 ds-harness-remote）；面板长在 Remote 的「远程工作台」弹窗里。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "remote",
    "peer",
    "agent",
    "multi-device"
  ],
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "locale/",
    "scripts/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "peerDependencies": {
    "ds-harness-remote": ">=0.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuanzhihang-s/dsh-peers-syh.git"
  },
  "homepage": "https://github.com/xuanzhihang-s/dsh-peers-syh#readme",
  "bugs": {
    "url": "https://github.com/xuanzhihang-s/dsh-peers-syh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "SYH",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "icon": "./icon.svg"
}