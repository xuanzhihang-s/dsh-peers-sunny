{
  "name": "dsh-peers-syh",
  "version": "0.1.0",
  "description": "给每台 DSH 设备起名，并让一个 agent 直接给另一台设备上的 agent 派活（基于 ds-harness-remote）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "remote",
    "peer",
    "agent",
    "multi-device"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "peerDependencies": {
    "ds-harness-remote": ">=0.6.0"
  },
  "author": "SYH",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
